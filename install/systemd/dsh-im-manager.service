# systemd user unit template for dsh-im-manager (Linux).
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp install/systemd/dsh-im-manager.service ~/.config/systemd/user/
#   # edit placeholders, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now dsh-im-manager
#   journalctl --user -u dsh-im-manager -f
#
# Replace __NODE__, __GATEWAY_DIR__, __CONFIG__, and the user name below.
[Unit]
Description=dsh-im-manager (IM channels for DeepSeek Harness)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__GATEWAY_DIR__
ExecStart=__NODE__ __GATEWAY_DIR__/bin/dsh-im-manager.js serve --config __CONFIG__
Restart=always
RestartSec=10
# Secrets stay out of the unit file; load them from a 0600 env file.
EnvironmentFile=-%h/.config/dsh-im-manager.env
Environment=DSH_IM_MANAGER_CONFIG=__CONFIG__

# Hardening (adjust if your workspace needs more):
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.dsh %h/.dsh-im-manager __GATEWAY_DIR__

[Install]
WantedBy=default.target
